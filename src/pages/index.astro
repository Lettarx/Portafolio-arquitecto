---
export const prerender = false
import CardProject from '../components/Card_Project.astro';
import Form from '../components/Form.astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SeccionProtafolio from '../components/Seccion_protafolio.astro';
import { type SanityDocument } from '@sanity/client';
import { sanityClient } from 'sanity:client';

import { actions } from 'astro:actions'
const result = Astro.getActionResult(actions.sendEmail)

if (result?.data?.success) {
  return Astro.redirect('/?success=true')
} else if (result?.error) {
  return Astro.redirect('/?error=true')
}

const POST_QUERY = `*[_type == "Proyecto"]{
  Nombre_proyecto,
  Year,
  Ubicacion,
  Breve_descripcion,
  Categoria,
  Fecha_publicacion,
  imagen[]{
    asset->{
      _id,
      url
    }
  }
}`;

const posts = await sanityClient.fetch<SanityDocument[]>(POST_QUERY);
---

<Layout>

	<!-- <Welcome /> -->
	<Header />
  <SeccionProtafolio />
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		{posts.map((post) => (
			<CardProject
				title={post.Nombre_proyecto}
				year={post.Year}
				location={post.Ubicacion}
				description={post.Breve_descripcion}
				category={post.Categoria}
				image={post.imagen?.[0]?.asset?.url}
			/>
		))}
	</div>

	<Form result={result} />
</Layout>
