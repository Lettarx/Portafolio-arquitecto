---
import { PortableText } from "astro-portabletext";
const { title, year, location, description, category, image } = Astro.props;
---
<article class="card">
    <img src={image} alt={title} />
    <div class="meta">
        <h4 class="card-title">{title}</h4>
        <p class="small">{year}</p>
        <p class="small">{location}</p>
        <div class="small">
            <PortableText value={description} />
        </div>
        <p class="small muted">{category}</p>
    </div>
</article>

<style>
    
.card {
  background: var(--card);
  border-radius: 14px;
  overflow: hidden;
}

.card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  display: block;
}

.card .meta {
  padding: 12px;
}

.card-title {
  font-size: 18px;
  margin: 0 0 4px 0;
}

.meta p {
  margin: 0 0 4px 0;
}
.small {
  font-size: 14px;
}

.muted {
  color: var(--muted);
}
</style>