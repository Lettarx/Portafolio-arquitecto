---
import { PortableText } from "astro-portabletext";
const { title, year, location, description, category, image } = Astro.props;
---
<article class="card">
    <img src={image} alt={title} />
    <div class="meta">
        <h4 class="card-title">{title}</h4>
        <p class="small">{year}</p>
        <p class="small">{location}</p>
        <p class="small muted">{category}</p>
    </div>
    <div class="side-info left">
        <div class="small">
            <PortableText value={description} />
        </div>
    </div>
    <div class="side-info right">
        <h4 class="card-title">{title}</h4>
        <p class="small">{year}</p>
        <p class="small">{location}</p>
        <p class="small muted">{category}</p>
    </div>
</article>