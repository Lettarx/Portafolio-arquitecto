---
import CardProject from "./Card_Project.astro"

import { type SanityDocument } from '@sanity/client';
import { sanityClient } from 'sanity:client';

const POST_QUERY = `*[_type == "Proyecto"]{
  Nombre_proyecto,
  Year,
  Ubicacion,
  Breve_descripcion,
  Categoria,
  Fecha_publicacion,
  imagen[]{
    asset->{
      _id,
      url
    }
  }
}`;

const posts = await sanityClient.fetch<SanityDocument[]>(POST_QUERY);
---

<section id="portafolio" class="section portfolio">
        <div class="container">
          <h3 class="section-title">Portafolio</h3>
          <div class="divider"></div>
          <div class="grid">
            {posts.map((post) => (
                <CardProject
                    title={post.Nombre_proyecto}
                    year={post.Year}
                    location={post.Ubicacion}
                    description={post.Breve_descripcion}
                    category={post.Categoria}
                    image={post.imagen?.[0]?.asset?.url}
                />
	    	))}
          </div>
          <div class="section-cta">
            <a href="#portafolio" class="btn btn-outline"
              >Ver todos los proyectos</a
            >
          </div>
        </div>
</section>

<style>
    .section-cta {
  text-align: center;
  margin-top: 24px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}
.divider {
  height: 1px;
  background: #ddd;
  margin: 12px 0 24px 0;
}
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

.section {
  padding: 56px 0;
}

.section-title {
  font-weight: 600;
  font-size: clamp(22px, 3.2vw, 28px);
}
.portfolio {
  background: #fff;
}
.btn {
  display: inline-block;
  padding: 12px 20px;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
}
.btn-outline {
  background: transparent;
  color: var(--text);
  border: 2px solid var(--accent);
}
</style>
