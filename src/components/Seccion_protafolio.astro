---
import CardProject from "./Card_Project.astro"

import { type SanityDocument } from '@sanity/client';
import { sanityClient } from 'sanity:client';

const POST_QUERY = `*[_type == "Proyecto"]{
  Nombre_proyecto,
  Year,
  Ubicacion,
  Breve_descripcion,
  Categoria,
  Fecha_publicacion,
  imagen[]{
    asset->{
      _id,
      url
    }
  }
}`;

 
const posts = await sanityClient.fetch<SanityDocument[]>(POST_QUERY);
---
<section id="portafolio" class="section portfolio">
  <div class="container">
    <div class="titulos">
      <h3 class="section-title">Portafolio</h3>
      <div class="divider"></div>
    </div>
    <div class="grid">
      {posts.map((post) => (
                <CardProject
                    title={post.Nombre_proyecto}
                    year={post.Year}
                    location={post.Ubicacion}
                    description={post.Breve_descripcion}
                    category={post.Categoria}
                    image={post.imagen?.[0]?.asset?.url}
                />
	    ))}
    </div>
    <div class="section-cta">
      <a id="showAllProjectsBtn" href="#portafolio" class="btn btn-outline" aria-expanded="false">Ver todos los
        proyectos</a>
    </div>
  </div>
</section>