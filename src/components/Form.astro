---
import { actions } from 'astro:actions'

const result_success = Astro.url.searchParams.get('success');
const result_error = Astro.url.searchParams.get('error');


---
{result_error && <p style="color:red">Error al enviar. Intenta de nuevo.</p>}
{result_success && <p style="color:green">¡Mensaje enviado con éxito!</p>}
<form method="POST" action={actions.sendEmail.toString()}>
  <label>
    Nombre:
    <input type="text" name="nombre" required />
  </label>
  <label>
    Email:
    <input type="email" name="email" required />
  </label>
  <label>
    Teléfono:
    <input type="tel" name="telefono" required />
  </label>
  <label >Tipo de Proyecto
    <select name="tipo-proyecto" required>
      <option value="residencial">Residencial</option>
      <option value="comercial">Comercial</option>
      <option value="Remodelacion">Remodelación</option>
      <option value="consulta">Consulta</option>
    </select>
  </label>
  <label>
    Mensaje:
    <textarea name="mensaje" required ></textarea>
  </label>
  <label>
    Presupuesto aproximado (opcional):
    <input type="number" name="presupuesto" />
  </label>
  <button class="btn btn-primary">Enviar</button>
</form>
<style>
  
form {
  display: grid;
  gap: 12px;
}

input,
textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #d9d9d9;
  border-radius: 10px;
  font: inherit;
  background: #fff;
}
.btn {
  display: inline-block;
  padding: 12px 20px;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
}

.btn-primary {
  background: var(--accent);
  color: #222;
  border: 2px solid var(--accent);
}
:root {
		--bg: #ffffff;
		--text: #1a1a1a;
		--muted: #6b6b6b;
		--accent: #f4d35e;
		--dark: #0f0f0f;
		--card: #f4f4f4;
	}
  select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }
</style>