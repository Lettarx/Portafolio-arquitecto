---
import Form from "./Form.astro"
---
<section id="contacto" class="section contact">
        <div class="container">
          <div class="divider"></div>

          <div class="contact-grid">
            <div class="contact-form">
              <h3 class="section-title">Contáctame</h3>
              <Form />
            </div>
            <div class="contact-info">
              <h4>Ubicación</h4>
              <ul class="contact-list">
                <li>Antilhue 6603-6621, Vitacura</li>
                <li>contacto@arquitectomv.cl</li>
                <li>+56 9 1234 1234</li>
              </ul>
              <div class="map">
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3331.958683623463!2d-70.57808992465289!3d-33.37214467342064!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c8df726694d9%3A0xfbf2295a8b3f2407!2sAntilhue%206603-6621%2C%20Vitacura%2C%20Regi%C3%B3n%20Metropolitana!5e0!3m2!1ses-419!2scl!4v1772687602038!5m2!1ses-419!2scl"
                  width="600"
                  height="300"
                  style="border: 0"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
            </div>
          </div>
        </div>
</section>

<style>
    
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

.section {
  padding: 56px 0;
}

.section-title {
  font-weight: 600;
  font-size: clamp(22px, 3.2vw, 28px);
}

.divider {
  height: 1px;
  background: #ddd;
  margin: 12px 0 24px 0;
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 36px;
  align-items: start;
}

.contact-info h4 {
  margin-top: 0;
}

.contact-list {
  list-style: none;
  padding: 0;
  margin: 8px 0 16px 0;
  color: var(--muted);
}

.map {
  width: 100%;
  height: 240px;
  border-radius: 12px;
  background: linear-gradient(135deg, #d6e6ff, #d4ffd9);
}

</style>
